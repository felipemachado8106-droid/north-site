---
interface Props {
  isCompact?: boolean;
  title?: string;
  subtitle?: string;
}

const {
  isCompact = false,
  title = 'Converse com a north.',
  subtitle = 'Preencha os dados abaixo para agendar uma conversa diagnóstica de 20 minutos. Avaliaremos suas situações mais críticas em inglês e traçaremos um plano direto.'
} = Astro.props;
---

<div class={`form-card ${isCompact ? 'compact' : ''}`}>
  <div class="form-header">
    <h3 class="form-title serif">{title}</h3>
    <p class="form-subtitle">{subtitle}</p>
  </div>

  <form data-north-form class="contact-form" novalidate>
    <div class="form-row">
      <div class="form-field">
        <label for="nome" class="form-label mono">Nome Completo</label>
        <input type="text" id="nome" name="nome" required placeholder="Como prefere ser chamado" class="form-input" autocomplete="name" />
        <span class="form-error" aria-live="polite"></span>
      </div>

      <div class="form-field">
        <label for="email" class="form-label mono">E-mail Profissional</label>
        <input type="email" id="email" name="email" required placeholder="nome@empresa.com" class="form-input" autocomplete="email" />
        <span class="form-error" aria-live="polite"></span>
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label for="cargo" class="form-label mono">Cargo & Empresa</label>
        <input type="text" id="cargo" name="cargo" required placeholder="Ex.: Diretor de Operações / Tech Lead" class="form-input" />
        <span class="form-error" aria-live="polite"></span>
      </div>

      <div class="form-field">
        <label for="objetivo" class="form-label mono">Principal Desafio Atual</label>
        <select id="objetivo" name="objetivo" class="form-input form-select" required>
          <option value="" disabled selected>Selecione a situação prioritária</option>
          <option value="calls">Calls e reuniões globais (participação ativa)</option>
          <option value="apresentacoes">Apresentações para diretoria ou conselho</option>
          <option value="negociacao">Negociação de contratos e alinhamento de prazos</option>
          <option value="entrevista">Preparação para entrevistas internacionais</option>
          <option value="viagens">Viagens de negócios e networking presencial</option>
          <option value="outro">Outro objetivo específico</option>
        </select>
        <span class="form-error" aria-live="polite"></span>
      </div>
    </div>

    <div class="form-field">
      <label for="mensagem" class="form-label mono">Em que momentos o inglês costuma falhar ou gerar hesitação?</label>
      <textarea id="mensagem" name="mensagem" rows="3" placeholder="Ex.: Consigo entender bem a pauta, mas travo na hora de contra-argumentar em discussões rápidas..." class="form-input form-textarea"></textarea>
      <span class="form-error" aria-live="polite"></span>
    </div>

    <button type="submit" class="btn btn-primary submit-btn">
      Solicitar Diagnóstico Profissional
    </button>

    <p class="form-disclaimer">
      Sem ligações insistentes ou scripts comerciais de telemarketing. Um coordenador da north. entra em contato por e-mail ou WhatsApp em até um dia útil.
    </p>
  </form>

  <!-- Success Message State -->
  <div class="form-success-message" hidden>
    <div class="success-icon">✓</div>
    <h4 class="success-title serif">Diagnóstico solicitado com sucesso.</h4>
    <p class="success-desc">
      Recebemos suas informações. Nossa coordenação analisará o contexto do seu cargo e entrará em contato nas próximas 24 horas úteis com os horários disponíveis para a conversa de diagnóstico.
    </p>
    <span class="mono success-meta">north. · Atendimento Executivo</span>
  </div>
</div>

<style>
  .form-card {
    background-color: var(--color-surface-pure);
    border: 1px solid var(--color-border);
    padding: var(--space-8);
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 40px rgba(28, 25, 23, 0.04);
  }

  @media (min-width: 768px) {
    .form-card {
      padding: var(--space-12);
    }
  }

  .form-header {
    margin-bottom: var(--space-8);
  }

  .form-title {
    font-size: clamp(1.75rem, 3vw, 2.375rem);
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .form-subtitle {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-label {
    font-size: 0.6875rem;
    color: var(--color-secondary);
    font-weight: 600;
  }

  .form-input {
    width: 100%;
    padding: 13px 16px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-primary);
    transition: all var(--motion-fast) var(--ease-standard);
    outline: none;
  }

  .form-input:focus {
    background-color: #FFFFFF;
    border-color: var(--color-wine);
    box-shadow: 0 0 0 3px var(--color-wine-glow);
  }

  .form-input.input-error {
    border-color: var(--color-error);
    background-color: #FFF5F5;
  }

  .form-select {
    cursor: pointer;
  }

  .form-textarea {
    resize: vertical;
    min-height: 90px;
  }

  .form-error {
    font-size: 0.75rem;
    color: var(--color-error);
    min-height: 16px;
  }

  .submit-btn {
    width: 100%;
    padding: 16px 28px;
    font-size: 1rem;
    margin-top: var(--space-2);
  }

  .form-disclaimer {
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: var(--space-2);
  }

  /* Success box */
  .form-success-message {
    text-align: center;
    padding: var(--space-12) var(--space-6);
  }

  .success-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto var(--space-4);
    background-color: var(--color-wine);
    color: #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .success-title {
    font-size: 1.875rem;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .success-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0 auto var(--space-6);
  }

  .success-meta {
    font-size: 0.6875rem;
    color: var(--color-wine);
  }
</style>
